# Copy to .env (never commit .env) and fill in.

# --- server
PORT=8080
# Where project state is stored (one JSON file per project). Mount a persistent volume here.
DATA_DIR=./data
# Set when running behind a load balancer or ingress so rate limiting sees real client IPs (e.g. 1 or loopback).
TRUST_PROXY=

# --- AI (optional: without a key the app runs with rules-based guidance only)
ANTHROPIC_API_KEY=
# Model used for analysis and chat, and a faster one for quick tasks such as column mapping.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
# Optional: route through an approved AI gateway instead of the public API endpoint.
ANTHROPIC_BASE_URL=
AI_MAX_TOKENS=1500
AI_RATE_LIMIT_PER_MIN=20
AI_MAX_PROMPT_CHARS=200000

# --- access (optional basic auth; use SSO at your ingress for production)
APP_USER=
APP_PASSWORD=
